        { "type": "keyword", "terms": ["Permanent Account Number", "Income Tax Department", "INCOME TAX DEPARTMENT"], "weight": 30, "match_mode": "any", "fuzzy": true },
        { "type": "keyword", "terms": ["Government of India", "GOVT OF INDIA"], "weight": 10, "match_mode": "any", "fuzzy": true },
